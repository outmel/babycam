# Copy to .env.local and fill in from Supabase → Project Settings → API.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional TURN relay for live view when both phones are behind strict NATs.
# Media stays end-to-end encrypted (DTLS-SRTP) even when relayed.
EXPO_PUBLIC_TURN_URL=
EXPO_PUBLIC_TURN_USERNAME=
EXPO_PUBLIC_TURN_CREDENTIAL=
